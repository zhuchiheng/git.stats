{
  "name": "git-stats-plus",
  "displayName": "Git Stats Plus",
  "description": "Beautiful visualization of team code contributions with interactive charts and insights, base on project git-stats of @lixianmin.",
  "version": "1.4.0",
  "publisher": "zhuchiheng",
  "author": {
    "name": "zhuchiheng"
  },
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "statistics",
    "visualization",
    "team",
    "contribution"
  ],
  "galleryBanner": {
    "color": "#6C5CE7",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuchiheng/git.stats"
  },
  "bugs": {
    "url": "https://github.com/zhuchiheng/git.stats/issues"
  },
  "homepage": "https://github.com/zhuchiheng/git.stats#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-stats.showStats",
        "title": "Show Git Stats",
        "icon": "$(graph-line)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "when": "scmProvider == git",
          "command": "git-stats.showStats",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/prune-moment.js && npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run && node scripts/webview-sanity.js",
    "sanity:webview": "node scripts/webview-sanity.js"
  },
  "dependencies": {
    "chart.js": "^4.4.8",
    "moment": "^2.29.4",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.60.0",
    "eslint": "^9.17.0",
    "segmentit": "^2.0.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8",
    "vsce": "^2.15.0",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
}
